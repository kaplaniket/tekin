# Vorlage fuer ~/.hermes/.env auf dem Cloud-Server.
# Nur ausfuellen, was du brauchst. Diese Datei NIE mit echten Werten committen.

# LLM-Provider (mindestens einer)
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Messaging-Gateway
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# Prime Intellect (alternativ: prime login)
PRIME_API_KEY=

# TypeSafe / Jev (Jev-Agent)
TYPESAFE_API_KEY=
# TYPESAFE_DEFAULT_MODEL=jev-latest
